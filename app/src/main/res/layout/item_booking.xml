<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <ImageView
            android:id="@+id/trainerProfileimg1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/trainerName1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="name"
            app:layout_constraintBottom_toBottomOf="@+id/trainerProfileimg1"
            app:layout_constraintStart_toEndOf="@+id/trainerProfileimg1"
            app:layout_constraintTop_toTopOf="@+id/trainerProfileimg1"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/trainerAge1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="age"
            app:layout_constraintEnd_toEndOf="@+id/trainerName1"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/trainerName1"
            app:layout_constraintTop_toBottomOf="@+id/trainerName1" />

        <TextView
            android:id="@+id/trainerSpecial1"
            android:layout_width="90dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:text="Specialization"
            app:layout_constraintEnd_toEndOf="@+id/trainerAge1"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/trainerAge1"
            app:layout_constraintTop_toBottomOf="@+id/trainerAge1" />

        <TextView
            android:id="@+id/trainerExp1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Experience"
            app:layout_constraintEnd_toEndOf="@+id/trainerSpecial1"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/trainerSpecial1"
            app:layout_constraintTop_toBottomOf="@+id/trainerSpecial1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBooking"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="125dp"
            android:layout_height="54dp"
            android:layout_marginStart="64dp"
            android:layout_marginTop="72dp"
            android:text="Book Now"
            app:icon="@drawable/baseline_arrow_forward_ios_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/trainerAge1"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>